{
	email {$ACME_EMAIL}
	# The admin API is not needed and should not listen.
	admin off
}

{$DOMAIN} {
	encode zstd gzip
	log {
		output stdout
		format console
	}

	# Security boundary (System-Design.md §9). The main domain serves the
	# team-facing surfaces only: webhooks, forms, and the dashboard. The n8n
	# editor lives on its own subdomain below — never on these paths.

	# Ingestion webhooks. Auth is the shared secret header checked inside the
	# n8n workflow itself; Caddy only has to not block it.
	handle /webhook/* {
		reverse_proxy n8n:5678
	}
	handle /webhook-test/* {
		reverse_proxy n8n:5678
	}

	# Admin forms for non-engineers. Basic auth here, not in n8n: the Form
	# Trigger's own auth has verified open bugs (A4).
	handle /form/* {
		basic_auth {
			{$ADMIN_FORM_USER} {$ADMIN_FORM_PASSWORD_HASH}
		}
		reverse_proxy n8n:5678
	}
	# Form assets are served from these paths; same protection.
	handle /form-waiting-room/* {
		basic_auth {
			{$ADMIN_FORM_USER} {$ADMIN_FORM_PASSWORD_HASH}
		}
		reverse_proxy n8n:5678
	}

	# Phase 5 — knowledge-base MCP server (bearer auth inside FastMCP).
	# handle /mcp/* {
	# 	reverse_proxy mcp:8000
	# }

	# Dashboard for the team (sales included) — read leads, manage sources,
	# browse the KB. The admin app has no auth of its own, so this basic_auth
	# IS its security boundary; same credentials as the forms above.
	handle {
		basic_auth {
			{$ADMIN_FORM_USER} {$ADMIN_FORM_PASSWORD_HASH}
		}
		reverse_proxy admin:8000
	}
}

# n8n editor — engineers only, protected by n8n's own login + TOTP 2FA
# (Settings → Personal). The System-Design §9 invariant still holds: NO n8n
# accounts for non-engineers — CE has no RBAC, any login can exfiltrate every
# stored credential (Pipedrive, Anthropic, Slack) through a scratch workflow.
n8n.{$DOMAIN} {
	encode zstd gzip
	log {
		output stdout
		format console
	}
	reverse_proxy n8n:5678
}
