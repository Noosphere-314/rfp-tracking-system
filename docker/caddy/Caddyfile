{
	email {$ACME_EMAIL}
	# The admin API is not needed and should not listen.
	admin off
}

{$DOMAIN} {
	encode zstd gzip
	log {
		output stdout
		format console
	}

	# CSP is affordable here precisely because CDNs are banned by design:
	# every asset is same-origin. It costs nothing today and blocks a whole
	# class of injection tomorrow — but it does mean zero inline styles and
	# zero inline <script>, which the v2 templates already respect.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "same-origin"
		Content-Security-Policy   "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
	}

	# Security boundary (System-Design.md §9). The main domain serves the
	# team-facing surfaces only: webhooks, forms, and the dashboard. The n8n
	# editor lives on its own subdomain below — never on these paths.

	# Ingestion webhooks. Auth is the shared secret header checked inside the
	# n8n workflow itself; Caddy only has to not block it.
	handle /webhook/* {
		reverse_proxy n8n:5678
	}
	handle /webhook-test/* {
		reverse_proxy n8n:5678
	}

	# Admin forms for non-engineers. Basic auth here, not in n8n: the Form
	# Trigger's own auth has verified open bugs (A4).
	handle /form/* {
		basic_auth {
			{$ADMIN_FORM_USER} {$ADMIN_FORM_PASSWORD_HASH}
		}
		reverse_proxy n8n:5678
	}
	# Form assets are served from these paths; same protection.
	handle /form-waiting-room/* {
		basic_auth {
			{$ADMIN_FORM_USER} {$ADMIN_FORM_PASSWORD_HASH}
		}
		reverse_proxy n8n:5678
	}

	# Phase 5 — knowledge-base MCP server (bearer auth inside FastMCP).
	# handle /mcp/* {
	# 	reverse_proxy mcp:8000
	# }

	# The worker's local dev mock. Unreachable from the internet REGARDLESS of
	# MOCK_N8N: once basic_auth came off the dashboard, that flag was the only
	# thing standing between the public and an endpoint that writes to
	# items_log and flips seen_items to 'done'. A flag that opens a public
	# write endpoint is one that eventually gets set by accident.
	handle /mock/* {
		respond 404
	}

	# Dashboard for the team (sales included) — read leads, manage sources,
	# browse the KB. basic_auth REMOVED: the boundary is now the session login
	# inside the app itself (admin/auth.py) — signed cookie, 30-minute idle
	# window, fail-closed CSRF, and a real "sign out" button, which basic auth
	# never had.
	handle {
		reverse_proxy admin:8000
	}
}

# n8n editor — engineers only, protected by n8n's own login + TOTP 2FA
# (Settings → Personal). The System-Design §9 invariant still holds: NO n8n
# accounts for non-engineers — CE has no RBAC, any login can exfiltrate every
# stored credential (Pipedrive, Anthropic, Slack) through a scratch workflow.
n8n.{$DOMAIN} {
	encode zstd gzip
	log {
		output stdout
		format console
	}

	# The workflow editor must never appear in search results: it is an internal
	# tool, and an indexed login page is exactly what makes a fresh domain look
	# like phishing to Safe Browsing in the first place.
	header X-Robots-Tag "noindex, nofollow, noarchive"

	# Google Search Console ownership proof. Served by Caddy rather than dropped
	# into the container: n8n has no static directory to put a file in, and a
	# bind mount would be a second moving part to keep alive across upgrades.
	# Google only checks the body, so a one-line respond is the whole file.
	# Do NOT delete after verification — Google re-checks periodically.
	handle /google3fb00eb9c37521eb.html {
		header Content-Type "text/html; charset=utf-8"
		respond "google-site-verification: google3fb00eb9c37521eb.html" 200
	}

	handle {
		reverse_proxy n8n:5678
	}
}
