# Copy to .env and fill in. Never commit .env.
# Secrets are split by owner (System-Design.md §9): the worker holds
# source-side read keys, n8n credentials hold write-side keys
# (Pipedrive, Claude, Slack posting). No key lives in two places.

# ─── Infrastructure ────────────────────────────────────────────────
# Prod profile only. One domain serves everything: dashboard + forms +
# webhooks on DOMAIN itself, the n8n editor on n8n.DOMAIN — point BOTH
# A-records (@ and n8n) at the server before starting Caddy.
DOMAIN=rfp.example.com
ACME_EMAIL=ops@example.com
TZ=Europe/Kyiv

POSTGRES_DB=rfp
POSTGRES_USER=rfp
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://rfp:password@postgres:5432/rfp

# n8n gets its own role and its own schema in the same instance.
N8N_DB_USER=n8n
N8N_DB_PASSWORD=
# openssl rand -hex 32 — losing this makes stored n8n credentials unreadable.
N8N_ENCRYPTION_KEY=

# ─── Дашборд (сесійний логін) ──────────────────────────────────────
# Спільний пароль команди. Замінює Caddy basic_auth для дашборда;
# basic_auth лишається тільки для /form/*.
DASHBOARD_PASSWORD=
# openssl rand -hex 32. СТАТИЧНИЙ: якщо генерувати на старті, кожен
# deploy.sh розлогінює всю команду. Порожній → контейнер не стартує.
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
# Пункт меню «n8n». Плоске значення — вкладену інтерполяцію
# ${N8N_URL:-https://n8n.${DOMAIN}} компоуз 2.2.3 псує мовчки.
N8N_URL=https://n8n.rfp.example.com

# Caddy basic auth for /form/* (the Form Trigger's own auth has open bugs, A4).
# NB: the dashboard no longer uses this — see DASHBOARD_PASSWORD above.
# Generate:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# The bcrypt hash contains `$` — wrap it in SINGLE quotes here, or compose's
# .env interpolation silently mangles it and every login fails.
ADMIN_FORM_USER=team
ADMIN_FORM_PASSWORD_HASH=

# ─── Worker → n8n ──────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://n8n:5678/webhook/rfp-item
# Shared secret sent as X-Webhook-Secret; the n8n webhook rejects anything else.
N8N_WEBHOOK_SECRET=

# ─── Worker behaviour ──────────────────────────────────────────────
RUN_INTERVAL_SECONDS=3600
FETCH_LOOKBACK_HOURS=72
# Items stay 'pending' until n8n's final node confirms the Pipedrive lead (A1).
PENDING_RETRY_AFTER_MINUTES=120
MAX_DELIVERY_ATTEMPTS=5
# Politeness: shared per-host token bucket, also used by the KB crawler later.
HOST_RATE_LIMIT_RPS=1.0
HOST_RATE_LIMIT_BURST=5
SOURCE_STAGGER_SECONDS=2.0
HTTP_TIMEOUT_SECONDS=30
# Honest, contactable UA — the forums' robots.txt bans anonymous SEO crawlers.
USER_AGENT=RFP-Tracker/1.0 (+mailto:email@woof.software)
ITEMS_LOG_RETENTION_DAYS=90

# ─── Source-side credentials (worker only) ─────────────────────────
# Free key, ~72h approval — request on day 1 (Deployment-Plan Stage 0).
SNAPSHOT_API_KEY=
# Free PAT, read-only, for the github_discussions fetcher (Stage 4).
GITHUB_TOKEN=
# Optional paid funding API (Stage 6 trigger).
CRYPTORANK_API_KEY=

# ─── Monitoring ────────────────────────────────────────────────────
# Dead-man's switch: pinged on every successful run.
HEALTHCHECKS_URL=
# Worker-side alerts (fetch failures, quarantine, dead items).
SLACK_WEBHOOK_URL=

# ── Knowledge base (research mode) ─────────────────────────────────
# Bearer token for the KB MCP server. REQUIRED on any non-localhost exposure.
KB_MCP_TOKEN=

# ── Briefing packs ─────────────────────────────────────────────────
# Anthropic key for KB briefing packs (kbmcp service). Empty = keyword tier.
ANTHROPIC_API_KEY=
